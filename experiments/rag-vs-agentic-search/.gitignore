# Python 虚拟环境与缓存
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 导入的语料（不进版本库）
corpus/

# 原始运行 trace（体积大、可重新生成；汇总表与图表进库）
results/runs/

# 本地模型缓存与临时文件
.cache/
.uv-cache/
*.log

# 本地模型配置（可能含 API key）。模板见 config/models.example.yaml
config/models.yaml

# 本地密钥文件（永不入库）
.env
.env.*
!.env.example
