# 依赖
node_modules/

# 构建产物
dist/
dist-mcp/
*.tsbuildinfo
# 语料暂存目录（scripts/corpus-stage.mjs 的产物，extraResources 从这里取语料正文）。
# 只忽略这一个子目录，不忽略整个 desktop/build/：那是 electron-builder 存放
# 图标等构建资源的常规位置，将来可能真的有需要进版本库的文件。
desktop/build/corpus/
# electron-builder 的输出目录（desktop/package.json 的 build.directories.output）
desktop/dist-installer/

# 测试与覆盖率
coverage/
.tmp/
*.log

# 本地运行数据
.harness/
.arts/
mcp-servers/kb/kb/
mcp-servers/kb/data/

# 工具与流程产物
.codeartsdoer/
.superpowers/

# 环境变量
.env
.env.*
!.env.example

# 语料 OTA 真实配置（模板见 config/corpus.example.json）：真实桶地址与公钥由构建时注入，不进仓库
config/corpus.local.json

# 密钥与证书（语料 OTA 的签名私钥、TLS 证书、SSH 私钥）
# 语料会进模型上下文，被篡改的语料就是一次提示注入；签名私钥泄露等同可向
# 全部用户推恶意语料，因此这一组按最坏情况预置，不靠「记得别提交」。
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.asc
*.sig
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
id_dsa
id_dsa.*

# 编辑器与操作系统
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# datasheet MCP 回归语料（ST 版权材料，本地资产，scripts/datasheet-corpus.mjs 下载）
mcp-servers/datasheet/corpus/
