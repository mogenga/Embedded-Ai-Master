{
  "name": "embedded-ai-master-desktop",
  "version": "0.1.4",
  "private": true,
  "description": "Desktop shell for Embedded AI Master — Electron window over the kernel",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "desktop": "electron main.js",
    "start": "electron main.js",
    "dist": "node ../scripts/package-prepare.mjs && electron-builder"
  },
  "devDependencies": {
    "electron": "^44.9.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "serialport": "^13.0.0"
  },
  "build": {
    "appId": "com.embedded-ai-master.app",
    "productName": "Embedded AI Master",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "main.js",
      "updater.js",
      "close-behavior.js",
      "preload.cjs",
      "host/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist"
      },
      {
        "from": "../dist-mcp",
        "to": "dist-mcp"
      },
      {
        "from": "build/corpus",
        "to": "corpus"
      },
      {
        "from": "../config/corpus.json",
        "to": "corpus.json"
      },
      {
        "from": "build/node_modules",
        "to": "node_modules"
      },
      {
        "from": "resources-package.json",
        "to": "package.json"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Embedded-AI-Master-Setup-${version}.${ext}",
      "signtoolOptions": {
        "signingHashAlgorithms": ["sha256"],
        "timeStampServer": "http://timestamp.digicert.com",
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mogenga",
        "repo": "Embedded-Ai-Master",
        "releaseType": "release"
      }
    ]
  }
}
