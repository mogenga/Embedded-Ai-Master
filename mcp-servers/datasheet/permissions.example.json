{
  "version": 1,
  "preset": "diagnose",
  "rules": [
    {
      "tool": "mcp__datasheet__datasheet_search",
      "action": "allow",
      "reason": "只读检索:页码与摘录是证据,不改变任何状态"
    },
    {
      "tool": "mcp__datasheet__datasheet_read",
      "action": "allow",
      "reason": "只读整页读取:命中后取上下文原文"
    },
    {
      "tool": "mcp__datasheet__datasheet_status",
      "action": "allow",
      "reason": "只读状态查询"
    },
    {
      "tool": "mcp__datasheet__datasheet_registers",
      "action": "allow",
      "reason": "只读结构化查询:启发式提取的寄存器表,引用前仍需 datasheet_read 核对原页"
    }
  ]
}
