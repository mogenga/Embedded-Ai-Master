{
  "name": "embedded-ai-master-kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "test:mcp": "vitest run mcp-servers",
    "probe:e2e": "node scripts/probe-e2e.mjs",
    "diagnosis:e2e": "node scripts/diagnosis-e2e.mjs",
    "kb:regression": "node scripts/kb-regression.mjs",
    "kb:review": "node scripts/kb-review.mjs",
    "test:desktop": "vitest run tests/desktop"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "electron": "^45.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.6"
  }
}
